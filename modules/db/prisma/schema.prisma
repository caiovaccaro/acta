// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Ideology {
  Left
  Center
  Right
}

enum CrawlStatus {
  pending
  in_progress
  done
  failed
}

model Outlet {
  id              String   @id @default(uuid())
  name            String   @unique
  ideology        Ideology
  credibilityScore Float   @default(0.5) // 0-1 scale
  rssFeeds        Json     // Array of RSS feed URLs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  crawlRequests   CrawlRequest[]
  articles        Article[]

  @@index([ideology])
  @@index([credibilityScore])
  @@map("outlets")
}

model CrawlRequest {
  id           String       @id @default(uuid())
  url          String       @unique
  outletId     String
  status       CrawlStatus  @default(pending)
  attempts    Int          @default(0)
  errorMessage String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  outlet       Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  article      Article?

  @@index([status])
  @@index([outletId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("crawl_requests")
}

model Article {
  id              String    @id @default(uuid())
  url             String    @unique
  crawlRequestId  String?   @unique
  outletId        String
  title           String    @db.Text
  textContent     String    @db.Text
  excerpt         String?   @db.Text
  publishedDate   DateTime?
  extractedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  outlet          Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  crawlRequest    CrawlRequest? @relation(fields: [crawlRequestId], references: [id], onDelete: SetNull)
  topicArticles   TopicArticle[]
  articleAnalysisAttempts ArticleAnalysisAttempt[]
  evidenceBullets EvidenceBullet[]
  articleStances ArticleStance[]

  @@index([outletId])
  @@index([publishedDate])
  @@index([extractedAt])
  @@index([url])
  @@map("articles")
}

// Article Analysis Pipeline Models

enum QuestionValidationStatus {
  pending
  validated
  rejected
  needs_reformulation
}

enum Stance {
  YesItSeemsSo
  ProbablyYes
  Unclear
  ProbablyNot
  NoItDoesntSeemSo
}

enum VerdictLabel {
  YesItSeemsSo
  ProbablyYes
  Unclear
  ProbablyNot
  NoItDoesntSeemSo
}

enum TopicSource {
  seeded
  auto_discovered
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum EvidenceType {
  Why
  Dissent
  Unknown
}

// Removed MatchClassificationStatus - ArticleQuestionMatch only stores successfully classified matches

model Topic {
  id                  String   @id @default(uuid())
  name                String   @unique
  description         String?  @db.Text
  safetyNoteRequired  Boolean  @default(false)
  source              TopicSource        @default(seeded)
  moderationStatus    ModerationStatus   @default(approved)
  discoveredAt        DateTime?
  discoveredFromArticles Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  questions           Question[]
  topicArticles       TopicArticle[]
  timelineEvents      TimelineEvent[]

  @@index([moderationStatus])
  @@index([source])
  @@map("topics")
}

model Question {
  id                  String                    @id @default(uuid())
  topicId             String
  questionText        String                    @db.Text
  originalQuestionText String?                   @db.Text
  // Optional 2–3 sentence LLM-generated context blurb about this question
  contextBlurb       String?                   @db.Text
  extractedAt         DateTime                  @default(now())
  confidence          Float?
  sourceArticlesCount Int                       @default(0)
  source              TopicSource               @default(seeded)
  discoveredAt        DateTime?
  discoveredFromArticles Json?
  validationStatus    QuestionValidationStatus  @default(pending)
  validationResults   Json?
  suggestions         String[]                  @default([]) // Bar validation suggestions
  isActive            Boolean                   @default(false)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  // Relations
  topic               Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  articleAnalysisAttempts ArticleAnalysisAttempt[]
  articleStances ArticleStance[]
  verdicts            Verdict[]        // Multiple verdicts (one per month)
  timelineEvents      TimelineEvent[]
  redirectsFrom       QuestionRedirect[] @relation("QuestionRedirects")
  redirectsTo         QuestionRedirect[] @relation("QuestionRedirectsTo")

  @@index([topicId])
  @@index([isActive])
  @@index([validationStatus])
  @@map("questions")
}

model TopicArticle {
  id        String   @id @default(uuid())
  topicId   String
  articleId String
  assignedAt DateTime @default(now())
  confidence Float?

  // Relations
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([topicId, articleId])
  @@index([topicId])
  @@index([articleId])
  @@map("topic_articles")
}

model ArticleAnalysisAttempt {
  id          String   @id @default(uuid())
  articleId   String
  questionId  String
  month       DateTime // Month period (YYYY-MM-01 format, always first day of month)
  stance      Stance
  confidence  Float    // 0-1, LLM confidence in classification
  reasoning   String?  @db.Text // LLM reasoning for stance
  analyzedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  articleStances ArticleStance[]

  @@unique([articleId, questionId, month]) // One analysis attempt per article-question-month triad
  @@index([questionId])
  @@index([articleId])
  @@index([month])
  @@index([questionId, month]) // Composite index for monthly verdict calculation
  @@index([stance])
  @@map("article_analyses")
}

model ArticleStance {
  id                    String   @id @default(uuid())
  articleId             String
  questionId            String
  articleAnalysisAttemptId String   @unique // Link to ArticleAnalysisAttempt (required - only successful classifications)
  matchedAt             DateTime @default(now())
  
  // Relations
  article               Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  question              Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  articleAnalysisAttempt ArticleAnalysisAttempt @relation(fields: [articleAnalysisAttemptId], references: [id], onDelete: Cascade)
  
  @@unique([articleId, questionId]) // One stance per article-question pair
  @@index([articleId])
  @@index([questionId])
  @@index([matchedAt])
  @@index([questionId, matchedAt]) // For querying "which articles have stances on this question"
  @@map("article_stances")
}

model Verdict {
  id           String      @id @default(uuid())
  questionId   String
  month        DateTime    // Month period (YYYY-MM-01 format, always first day of month)
  verdictLabel VerdictLabel
  confidence   Float       // 0-100, overall confidence
  supportShare Float       // 0-1, aggregate support (S)
  variance     Float       // 0-1, ideological dispersion
  reasoning    String?     @db.Text // LLM-generated summary of why the verdict is what it is
  // LLM-generated debate card data (stored to avoid repeated generation)
  overviewBullets Json?     // Array of overview bullet strings
  featuredPerspective Json?  // { text, articleId, articleTitle, outletName, articleUrl? }
  calculatedAt DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  question     Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  evidenceBullets EvidenceBullet[]

  @@unique([questionId, month]) // One verdict per question per month
  @@index([verdictLabel])
  @@index([confidence])
  @@index([month]) // For efficient month-based queries
  @@index([questionId, month]) // Composite index for common query pattern
  @@map("verdicts")
}

model EvidenceBullet {
  id        String       @id @default(uuid())
  verdictId String
  text      String       @db.Text
  articleId String?
  type      EvidenceType
  order     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  verdict   Verdict      @relation(fields: [verdictId], references: [id], onDelete: Cascade)
  article   Article?     @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([verdictId])
  @@index([type])
  @@map("evidence_bullets")
}

model TimelineEvent {
  id          String   @id @default(uuid())
  topicId     String?
  questionId  String?
  date        DateTime
  title       String
  description String   @db.Text
  order       Int // For manual ordering when dates are equal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic    Topic?    @relation(fields: [topicId], references: [id])
  question Question? @relation(fields: [questionId], references: [id])

  @@index([topicId])
  @@index([questionId])
  @@index([date])
  @@map("timeline_events")
}

model QuestionRedirect {
  id            String   @id @default(uuid())
  oldQuestionId String   @unique  // The question ID that was merged
  newQuestionId String   // The unified question ID
  convergedAt   DateTime @default(now())
  
  // Relations
  oldQuestion   Question @relation("QuestionRedirects", fields: [oldQuestionId], references: [id], onDelete: Cascade)
  newQuestion   Question @relation("QuestionRedirectsTo", fields: [newQuestionId], references: [id], onDelete: Cascade)
  
  @@index([oldQuestionId])
  @@index([newQuestionId])
  @@map("question_redirects")
}
