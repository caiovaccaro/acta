    "db:regenerate:overview-bullets": "tsx src/scripts/regenerateOverviewBullets.ts",
    "db:backfill:llm-content": "tsx src/scripts/backfillLlmContent.ts",
    "db:retry:failed-crawls": "tsx src/scripts/retryFailedCrawls.ts",
    "db:inspect:crawl-requests": "tsx src/scripts/inspectCrawlRequests.ts",
    "db:analyze:funnel": "tsx src/scripts/analyzePipelineFunnel.ts",
    "db:sync:production": "tsx src/scripts/syncToProduction.ts",
    "db:sync:from-production": "tsx src/scripts/syncFromProduction.ts",
    "db:backup:local": "tsx src/scripts/backupLocal.ts",
    "db:sync:schema-only": "tsx src/scripts/syncSchemaOnly.ts",
    "db:fix:verdict-confidence": "tsx src/scripts/fixVerdictConfidence.ts",
    "db:fix:orphans": "tsx src/scripts/fixOrphanRelations.ts",
