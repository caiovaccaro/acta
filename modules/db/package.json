{
  "name": "@acta/db",
  "version": "0.0.1",
  "type": "module",
  "description": "Acta Database Module - Prisma ORM and database utilities",
  "main": "src/index.ts",
  "scripts": {
    "db:generate": "bash scripts/load-env-and-run.sh npx prisma generate",
    "db:migrate": "bash scripts/load-env-and-run.sh npx prisma migrate dev",
    "db:migrate:deploy": "bash scripts/load-env-and-run.sh npx prisma migrate deploy",
    "db:studio": "bash scripts/load-env-and-run.sh npx prisma studio",
    "db:seed": "tsx src/seed.ts",
    "db:seed:topics": "tsx src/scripts/seedTopics.ts",
    "db:seed:questions": "tsx src/scripts/seedQuestions.ts",
    "db:validate:bar-questions": "tsx src/scripts/validateBarQuestions.ts",
    "db:revert:bar-reformulations": "tsx src/scripts/revertBarReformulations.ts",
    "db:calculate:verdicts": "tsx src/scripts/calculateVerdicts.ts",
    "db:summarize:verdicts": "tsx src/scripts/summarizeVerdicts.ts",
    "db:log:verdict-reasoning": "tsx src/scripts/logVerdictReasoning.ts",
    "db:discover:topics": "tsx src/scripts/discoverTopics.ts",
    "db:discover:questions": "tsx src/scripts/discoverQuestions.ts",
    "db:approve:topic": "tsx src/scripts/approveTopic.ts",
    "db:reject:topic": "tsx src/scripts/rejectTopic.ts",
    "db:generate:context-blurbs": "tsx src/scripts/generateContextBlurbs.ts",
    "db:generate:timeline-events": "tsx src/scripts/generateTimelineEvents.ts",
    "db:generate:debate-content": "tsx src/scripts/generateDebateCardContent.ts",
