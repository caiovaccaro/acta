    "db:classification:progress": "tsx src/scripts/classificationProgress.ts",
    "db:converge:similar-questions": "tsx src/scripts/convergeSimilarQuestions.ts",
    "db:converge:similar-topics": "tsx src/scripts/convergeSimilarTopics.ts",
    "db:deactivate:low-evidence-questions": "tsx src/scripts/deactivateLowEvidenceQuestions.ts",
    "db:reset": "bash scripts/load-env-and-run.sh npx prisma migrate reset",
    "db:health": "tsx src/scripts/healthCheck.ts",
    "test": "jest",
    "test:watch": "jest --watch"
