{
    "name": "acta",
    "version": "0.0.1",
    "type": "module",
    "description": "Acta Platform - Data-driven consensus verdicts on complex topics",
    "private": true,
    "workspaces": [
        "apps/*",
        "modules/*"
    ],
    "scripts": {
        "crawler:start": "pnpm --filter @acta/crawler start",
        "crawler:export:rss": "pnpm --filter @acta/crawler export:rss",
        "crawler:export:articles": "pnpm --filter @acta/crawler export:articles",
        "start": "pnpm crawler:start",
        "export:rss": "pnpm crawler:export:rss",
        "export:articles": "pnpm crawler:export:articles"
    },
    "author": "Caio Vaccaro",
