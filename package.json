{
    "name": "acta",
    "version": "0.0.1",
    "type": "module",
    "description": "Acta Platform - Data-driven consensus verdicts on complex topics",
    "private": true,
    "workspaces": [
        "apps/*",
        "modules/*"
    ],
    "scripts": {
        "crawler:start": "cd apps/crawler && npm start",
        "crawler:export:rss": "cd apps/crawler && npm run export:rss",
        "crawler:export:articles": "cd apps/crawler && npm run export:articles",
        "crawler:analyze": "cd apps/crawler && npm run analyze:articles --",
        "start": "npm run crawler:start",
        "export:rss": "npm run crawler:export:rss",
        "export:articles": "npm run crawler:export:articles",
        "analyze:articles": "npm run crawler:analyze",
        "db:studio": "cd modules/db && npm run db:studio",
        "db:generate": "cd modules/db && npm run db:generate",
        "db:migrate": "cd modules/db && npm run db:migrate",
        "db:migrate:deploy": "cd modules/db && npm run db:migrate:deploy",
        "db:push": "cd modules/db && npm run db:push",
        "db:health": "cd modules/db && npm run db:health",
        "db:seed:topics": "cd modules/db && npm run db:seed:topics",
        "db:seed:questions": "cd modules/db && npm run db:seed:questions",
        "db:validate:bar-questions": "cd modules/db && npm run db:validate:bar-questions",
        "db:revert:bar-reformulations": "cd modules/db && npm run db:revert:bar-reformulations",
        "db:calculate:verdicts": "cd modules/db && npm run db:calculate:verdicts",
        "db:summarize:verdicts": "cd modules/db && npm run db:summarize:verdicts",
        "db:log:verdict-reasoning": "cd modules/db && npm run db:log:verdict-reasoning",
        "db:discover:topics": "cd modules/db && npm run db:discover:topics",
        "db:discover:questions": "cd modules/db && npm run db:discover:questions",
        "db:approve:topic": "cd modules/db && npm run db:approve:topic",
        "db:reject:topic": "cd modules/db && npm run db:reject:topic",
        "admin:start": "npm run --workspace @acta/admin start"
    },
    "author": "Caio Vaccaro",
    "license": "ISC"
}
