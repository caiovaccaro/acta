{
    "name": "acta",
    "version": "0.0.1",
    "type": "module",
    "description": "Acta Platform - Data-driven consensus verdicts on complex topics",
    "private": true,
    "workspaces": [
        "apps/*",
        "modules/*"
    ],
    "scripts": {
        "crawler:start": "cd apps/crawler && npm start",
        "crawler:export:rss": "cd apps/crawler && npm run export:rss",
        "crawler:export:articles": "cd apps/crawler && npm run export:articles",
        "start": "npm run crawler:start",
        "export:rss": "npm run crawler:export:rss",
        "export:articles": "npm run crawler:export:articles",
        "db:studio": "cd modules/db && npm run db:studio",
        "db:generate": "cd modules/db && npm run db:generate",
        "db:migrate": "cd modules/db && npm run db:migrate",
        "db:migrate:deploy": "cd modules/db && npm run db:migrate:deploy",
        "db:push": "cd modules/db && npm run db:push",
        "db:health": "cd modules/db && npm run db:health"
    },
    "author": "Caio Vaccaro",
    "license": "ISC"
}
