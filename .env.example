# Production preflight requires a PostgreSQL URL and NODE_ENV=production.
# These values are synthetic examples only.
DATABASE_URL="postgresql://fixture:fixture@localhost:5432/acta?schema=public"
NODE_ENV=production

# Production preflight requires a valid email, a non-placeholder password of
# at least 16 characters, and a non-placeholder secret of at least 32 characters.
ADMIN_EMAIL="admin@example.invalid"
ADMIN_PASSWORD="synthetic-password-123"
ADMIN_SESSION_SECRET="synthetic-session-secret-1234567890"

# Optional: LLM analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Optional: paywalled outlets (never commit real values)
OUTLET_WSJ_LOGIN=
OUTLET_WSJ_PASSWORD=
OUTLET_TELEGRAPH_LOGIN=
OUTLET_TELEGRAPH_PASSWORD=
SESSION_ENCRYPTION_KEY=
