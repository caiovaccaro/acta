        "playwright": "^1.40.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.23.0",
        "@jest/globals": "^29.7.0",
        "@types/jest": "^29.5.12",
        "babel-jest": "^29.7.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.2",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    },
