{
    "name": "@acta/crawler",
    "version": "0.0.1",
    "type": "module",
    "description": "Acta RSS news crawler - automated ingestion and processing of news articles",
    "main": "src/scripts/runCrawler.js",
    "scripts": {
        "start": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/runCrawler.js",
        "export:rss": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/exportRss.js",
        "export:articles": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/exportArticles.js",
        "migrate:storage": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/migrateFromFileStorage.js",
        "analyze:articles": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/runAnalysisPipeline.js",
        "match:topics": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/matchArticlesToTopics.js",
        "classify:stances": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/classifyStances.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "health": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/healthCheck.js",
        "crawl-pending": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/crawlPendingRequests.js",
        "crawl-in-progress": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/crawlInProgressRequests.js",
        "drain-queue": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/drainCrawlQueue.js"
    },
    "dependencies": {
    "@acta/db": "file:../../modules/db",
    "@acta/core": "file:../../modules/core",
        "@mozilla/readability": "^0.6.0",
        "crawlee": "^3.0.0",
        "dotenv": "^17.2.3",
        "jsdom": "^27.1.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.23.0",
        "@jest/globals": "^29.7.0",
        "@types/jest": "^29.5.12",
        "babel-jest": "^29.7.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.2",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    },
    "author": "Caio Vaccaro",
    "license": "AGPL-3.0-only"
}
