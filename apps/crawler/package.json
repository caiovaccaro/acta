{
    "name": "@acta/crawler",
    "version": "0.0.1",
    "type": "module",
    "description": "Acta RSS news crawler - automated ingestion and processing of news articles",
    "main": "src/jobs/refreshFeeds.js",
    "scripts": {
        "start": "tsx src/jobs/refreshFeeds.js",
        "export:rss": "tsx src/scripts/exportRss.js",
